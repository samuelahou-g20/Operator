[Unit]
Description=Push Pluto MM2GAMMA_TOTAL risk into the MM2GAMMA-MM [Pluto-PRC-*] tabs
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# EDIT ME before enabling: absolute path to this repo's checkout on this machine.
WorkingDirectory=/path/to/operator
# User units start with a minimal PATH that excludes ~/.local/bin, where uv lives.
Environment=PATH=%h/.local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/uv run python -m scripts.pluto_prc_push
StandardOutput=journal
StandardError=journal
