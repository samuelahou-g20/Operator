# Template for the repo-root .env (git-ignored; never commit the real one).
# Copy this file to .env and fill in real values: cp .env.example .env
# See ONBOARDING.md for the full setup walkthrough and docs/bots.md for per-bot routing.

# --- Market data ------------------------------------------------------------
DATABENTO_API_KEY=            # Databento (CME futures) — databento.com account -> API keys
FRED_API_KEY=                 # FRED (rates) — fredaccount.stlouisfed.org/apikeys
BINANCE_API_KEY=              # Binance USD-M — binance.com API management
BINANCE_API_SECRET=
BINANCE_TESTNET_API_KEY=      # optional — testnet.binancefuture.com, for live-adapter testing
BINANCE_TESTNET_API_SECRET=
HYPERLIQUID_PRIVATE_KEY=      # Hyperliquid perps — wallet/agent-wallet private key
HL_MAIN_ADDRESS=              # optional — main account address, for agent-wallet setups

# --- Telegram bot tokens (one BotFather /newbot per bot; one long-poller per token) ---
TELEGRAM_AGG_BOT_TOKEN=
TELEGRAM_ORDERS_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=           # hedge_bot's token (legacy name: the shared "PnL bot")
TELEGRAM_TRADE_BOT_TOKEN=     # money-moving bot — issue its BotFather token last, guard it closely
TELEGRAM_JASON_BOT_TOKEN=
TELEGRAM_LS_BOT_TOKEN=
TELEGRAM_VOL_BOT_TOKEN=
TELEGRAM_MACRO_BOT_TOKEN=
TELEGRAM_SENTIMENT_BOT_TOKEN=
TELEGRAM_TWAP_BOT_TOKEN=      # /twap — TWAP over an explicit window from ccxt candles
TELEGRAM_BOTSTATUS_BOT_TOKEN= # /botstatus — Pluto BotManager roster, read-only (never starts/stops a bot)
TELEGRAM_OPERATOR_BOT_TOKEN=  # /operator — The Operator agent (src/the_operator); phase 0 = read-only tools

# --- Telegram chat routing (comma-separated numeric chat ids) --------------
TELEGRAM_CHAT_ID=             # market-data-bot allowlist (jason/ls/vol/macro/sentiment); superset of all desk chats
TELEGRAM_MM3_CHAT_ID=         # MM3 desk chat(s) — desk-aware bots (agg/orders/hedge/trade/botstatus) route ONLY by the per-desk vars, no default
TELEGRAM_MM2_CHAT_ID=         # MM2 desk chat(s). Per-desk vars MUST be disjoint (a chat pinned to two desks raises at startup)
TELEGRAM_MM4_CHAT_ID=        # MM4 desk chat(s) — agg/orders/trade; spot gamma only (no futures book),
                              # on CR_API_TOKEN_MM3 and the MM3 trader allowlist
TELEGRAM_OTC_CHAT_ID=         # OTC desk chat(s) — trade only; one catch-all SPOT book
                              # (OTC-GENERAL-J), no futures, on CR_API_TOKEN_MM3
TELEGRAM_TREASURY_CHAT_ID=    # Treasury desk chat(s) — agg (Pluto portfolio) + trade (g20ha-treasury-prop) + botstatus
TELEGRAM_OPTIONS_CHAT_ID=     # Options book chat(s) — agg only, Pluto portfolio TOTAL_OPTIONS (read-only, no trading)
TELEGRAM_MM5_CHAT_ID=         # MM5 desk chat(s) — agg only, Pluto portfolio QUANTMM_CLEAN (read-only, no trading)
TELEGRAM_LOG_BOT_TOKEN=       # /log bot's own BotFather token (one long-poller per token)
LOG_SHEET_ID=                 # /log target spreadsheet key; share it as Editor with the
                              # mm2-trades-agg service account (see docs/bots.md)
# LOG_SHEET_GID=0             # optional: target tab, defaults to the first
# Telegram user ids allowed to use the Operator at all. UNSET = every member of a
# served chat can run every read tool — set it before a real desk chat.
TELEGRAM_OPERATOR_USERS=
TELEGRAM_OPERATOR_CHAT_ID=    # chats The Operator serves (pilot roster); each must ALSO be pinned to a desk above, else startup fails
OPERATOR_ADMINS=              # Telegram user-ids allowed to /operator halt|resume (comma-separated); unset = nobody
OPERATOR_BRIEF_CHATS=         # chat ids for the 07:00 UTC morning brief (comma-separated, must be served); unset = off

# --- trade_bot trader allowlists (comma-separated numeric Telegram user-ids) ---
TELEGRAM_TRADE_TRADERS=          # MM3 traders authorized to place/cancel orders
TELEGRAM_TRADE_TRADERS_MM2=      # MM2 traders authorized to place/cancel orders
TELEGRAM_TRADE_TRADERS_TREASURY= # Treasury traders (unset = nobody can trade the treasury desk)
TELEGRAM_TRADE_TRADERS_OTC=      # OTC traders (unset = nobody can trade the OTC desk)

# --- CoinRoutes SOR API (g20jpy.coinroutes.io) — one key PER DESK --------------
CR_API_TOKEN_MM3=             # mm3 bot key (trade/orders/hedge on the mm3 chat; mm3_perf_report)
CR_API_TOKEN_MM2=             # mm2 bot key (trade/orders/hedge on the mm2 chat; mm2_trade_log_bot)
CR_API_TOKEN_G20JPY=          # treasury desk + fallback (the original personal/account key)

# --- Pluto JASON levels API --------------------------------------------------
PLUTO_API_KEY=
PLUTO_API_SECRET=

# --- Reference Data Service (RDS) — asset-location -> location_id registry ----
# flow_alert daemon resolves MM3 gamma location_ids from here (refsvc.prod.g20api.com/ref-svc).
REFSVC_USER=prod_system_reader   # system read user (password in LastPass); daemon mints its own JWT
REFSVC_PASSWORD=
# REFSVC_TOKEN=                   # alternative: a pre-minted long-lived JWT instead of user/password
# FLOW_ALERT_THRESHOLD_USD=5000   # optional: window delta ($) that triggers an alert (default 5000)
# FLOW_ALERT_WINDOW_MIN=10        # optional: rolling window size in minutes (default 10)
# FLOW_ALERT_THRESHOLD_USD_MM2=50000   # optional per-desk override (…_MM3 too); MM2's flow is
#                                      # chunkier than MM3's, so one shared number over-alerts

# --- Anthropic (macro_bot, sentiment_bot) -----------------------------------
ANTHROPIC_API_KEY=            # console.anthropic.com -> API keys

# --- X (Twitter) API v2 (sentiment_bot) -------------------------------------
X_BEARER_TOKEN=                # developer.x.com app with pay-per-use credits — bearer token only, no OAuth1 keys needed

# --- Polymarket (The Operator's prediction_markets) -------------------------
POLYMARKET_PROXY=              # e.g. http://127.0.0.1:8888 — the nordlayer-pm VPN container; Polymarket is DNS-blocked here

# --- Google service-account keys (optional; each falls back to a repo-root JSON file) ---
# agg_bot: readonly SA for reading the aggregation sheet -> .gsa_key.json
GOOGLE_AGG_SA_KEY=
# mm2_trade_log_bot: editor SA for writing the MM2 trade log sheet -> .mm2_trades_gsa_key.json
GOOGLE_MM2_SA_KEY=

# --- Redis (only needed for live streaming, not the Telegram bots) ---------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Optional ops knobs ------------------------------------------------------
OPERATOR_LOG_FILE_ONLY=          # set to disable console log echo, file-only logging
OPERATOR_MONITOR_DIAG=           # set to enable extra data-quality monitor diagnostics

# --- ZP quoting review (src/the_operator/zp, docs/zp_spec.md) ---------------
# Orderbook snapshot DB ("OrderbookAnalysis" on RDS Postgres): depth compliance, uptime and book
# widths. Unset = those sections report "not measured" and the rest of the ZP still runs. No new
# dependency: psycopg is already installed. URL-encode the password ($ -> %24, ^ -> %5E, @ -> %40).
ZP_OB_DB_URL=                 # postgresql+psycopg://USER:PASSWORD@HOST:5432/OrderbookAnalysis
# gamma-dash (dynamic-mode settings + vol history). Comma-separated, tried in order; the public
# host is behind Entra SSO from a server, so a reachable backend/tunnel address is what works.
GAMMA_DASH_BASE_URL=          # e.g. http://127.0.0.1:8618/api/price-bias,https://gamma-dash.ext.g20api.com/api/price-bias
